	apply_corrections(apply_corrections<hr/><small><em>role = Program applies confirmed corrections</em></small>)
	run_statistical_test(run_statistical_test<hr/><small><em>role = Python SciPy statistical tool</em></small>)
	build_stats_block(build_stats_block<hr/><small><em>role = Program protected statistics</em></small>)
