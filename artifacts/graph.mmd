	plan_analysis -. &nbsp;error&nbsp; .-> issue_notice;
	plan_analysis -. &nbsp;ready&nbsp; .-> prepare_data_summary;
	prepare_data_summary --> llm_diagnostics;
	prepare_data_summary --> stat_diagnostics;
	request_clarification --> apply_corrections;
	review_report -. &nbsp;review_passed&nbsp; .-> deliver_report;
	review_report -. &nbsp;error&nbsp; .-> issue_notice;
	review_report -. &nbsp;revise_once&nbsp; .-> revise_report;
	revise_report --> check_report;
	run_statistical_test --> build_stats_block;
	stat_diagnostics --> merge_diagnostics;
	save_session --> __end__;
	plan_analysis -. &nbsp;revise_plan_once&nbsp; .-> plan_analysis;
