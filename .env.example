# Copy this file to ".env" (same folder) and adjust it. Never submit or share a .env that contains API keys.

# real = call both LLMs; mock = rule-based stand-ins (control-flow test only)
# auto = real if every chosen model is usable (API key set for cloud models; local Ollama models need none)
LLM_MODE=auto

# Model A (Analysis Agent) and Model B (Review Agent) must be DIFFERENT underlying models.
# Format: provider:model

# Option 1: local models via Ollama (free, no key). Install Ollama, then: ollama pull qwen3:8b / ollama pull gemma3:12b
MODEL_A=ollama:qwen3:8b
MODEL_B=ollama:gemma3:12b

# Option 2: cloud APIs (comment out option 1 and fill in the keys)
# MODEL_A=openai:gpt-4.1-mini
# MODEL_B=anthropic:claude-sonnet-5-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: full path to Rscript.exe if it is not found automatically
# RSCRIPT_PATH=C:\Program Files\R\R-4.4.1\bin\Rscript.exe
